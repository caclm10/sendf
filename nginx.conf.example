# =========================================================================
# TEMPLATE KONFIGURASI NGINX UNTUK PRODUCTION (sendf)
# =========================================================================
# Gunakan konfigurasi ini di server Anda (biasanya di /etc/nginx/sites-available/sendf)
# SSL (HTTPS) sepenuhnya ditangani oleh Cloudflare, jadi Nginx di VPS cukup
# mendengarkan port HTTP 80 saja.
# =========================================================================

server {
    listen 80;
    listen [::]:80;
    server_name sendf.domainanda.com; # Ganti dengan domain Anda dari Cloudflare

    # Batas ukuran upload file (samakan dengan batas Express 200MB)
    # Catatan: Jika menggunakan Cloudflare Free/Pro, batas upload maksimal adalah 100MB.
    client_max_body_size 200M;

    location / {
        # Mengarahkan trafik ke port aplikasi (Port 5000 jika Docker berjalan di server yang sama)
        proxy_pass http://127.0.0.1:5000;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Mengirim IP asli klien dari Cloudflare ke backend Node.js
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout saat upload file berukuran besar
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
