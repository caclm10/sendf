# =========================================================================
# TEMPLATE KONFIGURASI NGINX UNTUK PRODUCTION (sendf)
# =========================================================================
# Pilih salah satu opsi di bawah ini yang sesuai dengan infrastruktur Anda.
# Salin file ini ke server Anda, biasanya di: /etc/nginx/sites-available/sendf
# =========================================================================

# -------------------------------------------------------------------------
# OPSI A: MENGGUNAKAN CLOUDFLARE (Rekomendasi - Lebih Sederhana & Aman)
# -------------------------------------------------------------------------
# Gunakan konfigurasi ini jika domain Anda diarahkan ke Cloudflare (Awan Oranye aktif).
# Cloudflare akan menangani SSL (HTTPS), dan Nginx di VPS hanya mendengar port 80.
# Di Cloudflare, atur mode SSL/TLS ke "Flexible".

server {
    listen 80;
    listen [::]:80;
    server_name sendf.domainanda.com; # Ganti dengan domain Anda

    # Batas ukuran upload file (samakan dengan batas Express 200MB)
    client_max_body_size 200M;

    location / {
        # Mengarahkan trafik ke Docker Container port 5000
        proxy_pass http://127.0.0.1:5000;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Meneruskan IP asli dari Cloudflare ke aplikasi Node.js
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout saat upload file besar
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}


